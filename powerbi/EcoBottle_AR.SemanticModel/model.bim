            "dataType": "string",
            "lineageTag": "4a8c6967-6226-4870-a554-83a94786cba3",
            "sourceColumn": "day_name",
            "summarizeBy": "none"
          },
          {
            "name": "Año mes",
            "dataType": "string",
            "expression": "FORMAT(dim_date[date_value], \"yyyy-MM\")",
            "lineageTag": "d5acdceb-7c79-4431-87b2-6c3474fa4a7f",
            "summarizeBy": "none",
            "type": "calculated"
          }
        ],
        "lineageTag": "64915d69-cdd3-4949-9d14-4b9774fd21f9",
        "measures": [
          {
            "name": "Ventas ARS",
            "expression": "SUM('fact_sales_order'[venta_neta])",
            "formatString": "\"$\" #,0.00;(\"$\" #,0.00);\"$\" 0.00",
            "lineageTag": "22e3d3a6-1d0a-42e8-a9f4-d0bb63fd60c5"
          },
          {
            "name": "Pedidos",
            "expression": [
              "CALCULATE(",
              "    COUNTROWS('fact_sales_order'),",
              "    'fact_sales_order'[es_venta] = TRUE()",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "f88b322d-da35-4197-8616-2a8afdeba810"
          },
          {
            "name": "Ticket Promedio ARS",
            "expression": "DIVIDE([Ventas ARS], [Pedidos])",
            "formatString": "\"$\" #,0.00;(\"$\" #,0.00);\"$\" 0.00",
            "lineageTag": "30e96271-6994-49a3-a9eb-8044150d8126"
          },
          {
            "name": "Clientes Compradores",
            "expression": [
              "CALCULATE(",
              "    DISTINCTCOUNT('fact_sales_order'[customer_key]),",
              "    'fact_sales_order'[es_venta] = TRUE()",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "9289e2c9-4f89-4a56-b42c-6db43f1275d3"
          },
          {
            "name": "Ventas por Producto ARS",
            "expression": "SUM('fact_sales_order_item'[venta_neta])",
            "formatString": "\"$\" #,0.00;(\"$\" #,0.00);\"$\" 0.00",
            "lineageTag": "236ec790-c0f3-4585-a6e3-9a0f5f0e72a5"
          },
          {
            "name": "Ranking Producto",
            "expression": "RANKX(ALLSELECTED(dim_product), [Ventas por Producto ARS], , DESC, DENSE)",
            "formatString": "#,0",
            "lineageTag": "899c9e44-6a99-4d24-8378-b248b5dd81ad"
          },
          {
            "name": "Sesiones",
            "expression": "COUNTROWS('fact_web_session')",
            "formatString": "#,0",
            "lineageTag": "640d0e9d-76ed-42d3-843e-d816cba1bd0e"
          },
          {
            "name": "Sesiones Anonimas",
            "expression": "CALCULATE([Sesiones], 'fact_web_session'[customer_key] = -1)",
            "formatString": "#,0",
            "lineageTag": "e14a73ba-a62b-44a1-ad91-95b1ea20331d"
          },
          {
            "name": "Usuarios Activos",
            "expression": [
              "CALCULATE(",
              "    DISTINCTCOUNT('fact_web_session'[customer_key]),",
              "    'fact_web_session'[customer_key] <> -1",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "877b277d-4a09-4b1c-9262-f1e9b9dc9df0"
          },
          {
            "name": "Duracion Media (s)",
            "expression": "AVERAGE('fact_web_session'[duration_seconds])",
            "formatString": "0.0",
            "lineageTag": "9c2a7562-5409-4bc6-9b0b-7f61f66b8447"
          },
          {
            "name": "Respuestas NPS",
            "expression": "COUNTROWS('fact_nps_response')",
            "formatString": "#,0",
            "lineageTag": "6b41fabd-1ab5-4204-b5d4-630832a9e7a1"
          },
          {
            "name": "Promotores",
            "expression": "CALCULATE([Respuestas NPS], 'fact_nps_response'[score] >= 9)",
            "formatString": "#,0",
            "lineageTag": "95269b04-e4d4-4514-868f-51a9c61ddae8"
          },
          {
            "name": "Detractores",
            "expression": "CALCULATE([Respuestas NPS], 'fact_nps_response'[score] <= 6)",
            "formatString": "#,0",
            "lineageTag": "1086241b-1c15-4ff8-b407-a07a86945f2f"
          },
          {
            "name": "NPS",
            "expression": "DIVIDE([Promotores] - [Detractores], [Respuestas NPS]) * 100",
            "formatString": "0.0",
            "lineageTag": "d19d4382-5dbd-405c-af33-a7030d001903"
          },
          {
            "name": "Pasivos",
            "expression": "CALCULATE([Respuestas NPS], fact_nps_response[score] >= 7, fact_nps_response[score] <= 8)",
            "formatString": "#,0",
            "lineageTag": "93c82aec-dc80-415c-82ce-dc41ba3aaa3a"
          },
          {
            "name": "Unidades vendidas",
            "expression": "CALCULATE(SUM(fact_sales_order_item[quantity]), fact_sales_order_item[es_venta] = TRUE())",
            "formatString": "#,0",
            "lineageTag": "55392ff7-7685-4de5-bd9a-6e9ede2c3de8"
          },
          {
            "name": "Porcentaje anónimas",
            "expression": "DIVIDE([Sesiones Anonimas], [Sesiones])",
            "formatString": "0.0%",
            "lineageTag": "fb223179-64f4-4325-8ec0-09e9eaf6f5cd"
          }
        ],
        "partitions": [
          {
            "name": "dim_date",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Archivo = RutaDW & \"\\dim_date.csv\",",
                "    Origen = Csv.Document(File.Contents(Archivo), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),",
                "    Nulos = Table.ReplaceValue(Encabezados, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Encabezados)),",
                "    Tipada = Table.TransformColumnTypes(Nulos, {{\"date_key\", Int64.Type}, {\"date_value\", type date}, {\"year\", Int64.Type}, {\"month\", Int64.Type}, {\"month_name\", type text}, {\"day\", Int64.Type}, {\"day_name\", type text}}, \"en-US\")",
                "in",
                "    Tipada"
              ],
              "type": "m"
            }
          }
        ]
