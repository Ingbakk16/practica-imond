                "    Tipada = Table.TransformColumnTypes(Nulos, {{\"nps_id\", Int64.Type}, {\"date_key\", Int64.Type}, {\"channel_key\", Int64.Type}, {\"customer_key\", Int64.Type}, {\"responded_at\", type datetime}, {\"score\", Int64.Type}, {\"comment\", type text}}, \"en-US\")",
                "in",
                "    Tipada"
              ],
              "type": "m"
            }
          }
        ]
      }
    ]
  }
}